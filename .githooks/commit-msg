#!/usr/bin/env bash
# Delegate commit-msg to the tracked pre-commit config (conventional commits + trailer strip).
set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit is required. Install: pip install pre-commit && pre-commit install --hook-type commit-msg" >&2
  exit 1
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=commit-msg --hook-dir "$HERE" -- "$@"
