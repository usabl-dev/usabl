#!/usr/bin/env bash
# This clone uses core.hooksPath=.githooks, so the default .git/hooks install is skipped.
# Fail closed if pre-commit is missing. --no-verify still exists; CI is the backstop.
set -euo pipefail

if ! command -v pre-commit >/dev/null 2>&1; then
  echo "pre-commit is required. Install: pip install pre-commit && pre-commit install" >&2
  exit 1
fi

HERE="$(cd "$(dirname "$0")" && pwd)"
exec pre-commit hook-impl --config=.pre-commit-config.yaml --hook-type=pre-commit --hook-dir "$HERE" -- "$@"
