{
  "name": "usabl",
  "version": "0.0.0",
  "description": "Accessibility proof engine",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "usabl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./playwright": {
      "types": "./dist/playwright-helper.d.ts",
      "import": "./dist/playwright-helper.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "check": "npm run typecheck && npm run test",
    "measure:fleet-insights": "node --experimental-strip-types scripts/measure-fleet-insights.ts",
    "prepare": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "js-yaml": "4.3.1",
    "playwright": "1.62.1",
    "zod": "3.23.8"
  }
}
