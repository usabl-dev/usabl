{
  "name": "usabl",
  "version": "0.2.0",
  "description": "Accessibility proof engine",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usabl-dev/usabl.git"
  },
  "homepage": "https://github.com/usabl-dev/usabl",
  "bugs": {
    "url": "https://github.com/usabl-dev/usabl/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "usabl": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vite": {
      "types": "./dist/vite-plugin.d.ts",
      "import": "./dist/vite-plugin.js"
    },
    "./playwright": {
      "types": "./dist/playwright-helper.d.ts",
      "import": "./dist/playwright-helper.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsup",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:package",
    "measure:fleet-insights": "vite-node scripts/measure-fleet-insights.ts",
    "prepare": "bash scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "axe-core": "4.13.0",
    "js-yaml": "4.3.1",
    "playwright": "1.62.1",
    "zod": "3.25.76"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
